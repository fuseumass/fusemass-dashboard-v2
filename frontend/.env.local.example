# Copy to `.env.local`.

# Base URL of the Express backend.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- White-label branding --------------------------------------------------
# This platform is not tied to any one hackathon. Set these per deployment.

# Public name shown throughout the UI and in the browser tab.
NEXT_PUBLIC_ORG_NAME=Your Hackathon

# Logo used on public/auth pages. Drop the file in `public/` and reference it
# by path (you'll upload logo.png later).
NEXT_PUBLIC_LOGO=/logo.png

# Logo used inside the logged-in dashboard sidebar (you'll upload logo-v2.png).
NEXT_PUBLIC_LOGO_V2=/logo-v2.png

# Optional brand accent color (any CSS color). Drives buttons/links/highlights.
NEXT_PUBLIC_BRAND_COLOR=#4f46e5

# IANA time zone the event happens in (e.g. America/New_York). Event times are
# shown in this zone so organizers elsewhere see what attendees see. Leave empty
# to show times in each viewer's own zone. (Moves to the branding API later.)
NEXT_PUBLIC_EVENT_TIMEZONE=
