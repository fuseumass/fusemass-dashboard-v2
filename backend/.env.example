# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the Express server listens on
PORT=4000

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/hackumass

# Secret used to sign and verify JWTs — make this long and random in production
JWT_SECRET=change-me-to-a-long-random-string

# How long an issued token stays valid (see `ms`/jsonwebtoken docs for format)
JWT_EXPIRES_IN=7d

# Origin of the Next.js frontend, used for CORS
CLIENT_ORIGIN=http://localhost:3000
