# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Core ------------------------------------------------------------------
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/hackdash
# The frontend's address, or several separated by commas (e.g. with and without
# "www"). All of them may call the API; the first is used in emailed links.
CLIENT_ORIGIN=http://localhost:3000

# ---- Reverse proxy ---------------------------------------------------------
# Leave unset for local development and for anything not behind a proxy.
# When deployed behind one (Render, Fly, nginx, a load balancer), set this to
# the number of proxy hops in front of the app — usually 1 — so rate limiting
# sees each visitor's real IP instead of putting everyone in one bucket.
# Do not set it when there is no proxy: clients could then forge
# X-Forwarded-For and dodge the rate limiter.
# TRUST_PROXY=1

# ---- Auth rate limiting ----------------------------------------------------
# Shared defaults for the login / register / forgot-password / setup-admin
# limiters. Each endpoint keeps its own separate budget.
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20
# Optional per-endpoint overrides, for loosening just one (e.g. day-of signups
# where the whole venue shares a single NAT'd IP):
# AUTH_RATE_LIMIT_MAX_LOGIN=20
# AUTH_RATE_LIMIT_MAX_REGISTER=20
# AUTH_RATE_LIMIT_MAX_FORGOT_PASSWORD=20
# AUTH_RATE_LIMIT_MAX_SETUP_ADMIN=20
# Resending the email-verification link (each request sends an email):
# AUTH_RATE_LIMIT_MAX_RESEND_VERIFICATION=20
# Applying without an account (admin setting), per IP per window:
# AUTH_RATE_LIMIT_MAX_PUBLIC_APPLY=20
# Team invites (each sends an email):
# AUTH_RATE_LIMIT_MAX_TEAM_INVITE=20

# ---- White-label branding (this platform is not tied to any one hackathon) --
# The hackathon's public name. Used in emails and the "have you attended <NAME>
# before?" application question.
ORG_NAME=Your Hackathon
# Public links used in emails ({{websiteUrl}} / {{discordUrl}} in templates),
# e.g. the "you're checked in" email. Each hackathon sets its own.
ORG_WEBSITE_URL=https://hackathon.com
ORG_DISCORD_URL=https://discord.gg/your-invite
# Optional: the Discord mentorship channel or ticket-bot link. Mentorship
# tickets are created on Discord, so the dashboard only links to it (shown to
# logged-in attendees on their home page, next to the Discord invite). Leave
# empty to show nothing.
# ORG_DISCORD_MENTORSHIP_URL=https://discord.com/channels/<server>/<channel>
# IANA time zone the run of show is written in for emails.
EVENT_TIMEZONE=America/New_York

# ---- Runtime branding defaults ---------------------------------------------
# Served by GET /api/meta/branding together with ORG_NAME above. Admins can
# override every one of these in Settings -> Branding without a redeploy; the
# order is: admin setting -> these -> built-in default. They are read on each
# request (cached for about a minute), so one image can serve every hackathon
# and a restart is all it takes to change them.
# Colours must be exactly #RRGGBB (a malformed value is ignored, with a
# warning in the log). Image URLs must be http(s) URLs.
# BRAND_PRIMARY=#4f46e5
# BRAND_SECONDARY=#64748b
# BRAND_ACCENT=
# BRAND_LOGO_URL=
# BRAND_LOGO_DARK_URL=
# BRAND_FAVICON_URL=
# Public address of THIS API (no trailing slash). Logos uploaded by an admin
# are served by the API at /api/meta/branding/files/<name>; when this is set the
# branding endpoint returns absolute links, otherwise root-relative paths that
# the frontend resolves against its NEXT_PUBLIC_API_URL.
# API_PUBLIC_URL=https://api.example.com
# How long (ms) each instance keeps the org settings in memory for the feature
# flags and the branding endpoint, to spare the database. Admin saves take
# effect on the instance that handled them immediately and on others within
# this long. 0 turns the cache off.
# SETTINGS_CACHE_TTL_MS=10000

# ---- First-admin bootstrap -------------------------------------------------
# Set to "true" temporarily to allow POST /api/auth/setup-admin to promote the
# first admin (by email). It only works while no admin exists. Set back to
# "false" once your admin is created.
SETUP_ADMIN=false

# ---- JWT -------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Google OAuth ----------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# The callback URL must be registered there exactly.
# Master on/off switch for Google sign-in. Even when "true", it also requires
# the credentials below AND the admin's org setting (admins can turn it off in
# the settings panel without a redeploy). Set "false" to force it off.
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---- Email (nodemailer: password resets, application + check-in emails) ----
# Easiest: run `npm run setup-email`, which fills these in for a Gmail account
# with an app password and tests them first. See README "Setting up email".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Your Hackathon <no-reply@example.com>"
# Optional outbox settings (README "Email outbox"); the defaults are fine:
# EMAIL_DAILY_LIMIT=500          # per 24 h; bulk sends refuse to pass it (0 = no check)
# EMAIL_RETRY_INTERVAL_MS=30000  # how often failed emails are retried
# EMAIL_LOG_RETENTION_DAYS=90    # how long the email log is kept

# ---- Discord notifications (optional) ---------------------------------------
# Webhook URLs (Discord channel -> Edit Channel -> Integrations -> Webhooks).
# Treat them as secrets: anyone with one can post to the channel.
# Every server error (scrubbed of emails, credentials and tokens; at most 10
# posts a minute):
DISCORD_ERROR_WEBHOOK_URL=
# Every submitted application (name, school, round, link to review it):
DISCORD_APPLICATIONS_WEBHOOK_URL=

# ---- Azure Blob Storage (resume uploads) -----------------------------------
# Keep the container private (no anonymous blob access): resumes are opened
# through short-lived signed links the backend creates after an access check.
# Signing uses the account key, so paste a connection string that includes
# `AccountKey=` (Storage account -> Access keys), not a SAS-based one.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=resumes

# Logos and the favicon uploaded in Settings -> Branding go in a second container,
# also private: the API streams them to browsers (GET /api/meta/branding/files/
# <name>) after checking they are real PNG/JPEG/WebP/ICO images, so anonymous
# blob access never has to be enabled on the storage account. Created on first
# upload if it does not exist. Uses the same connection string as above.
# AZURE_STORAGE_BRANDING_CONTAINER=branding
